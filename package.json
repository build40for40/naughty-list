{
  "name": "naughty-list",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run wrangler -- dev",
    "test": "node --test",
    "evidence": "node scripts/evidence.mjs",
    "scores": "node scripts/santa-scores.mjs",
    "check": "npm test && npm run wrangler -- deploy --dry-run",
    "extension:package:chrome": "node scripts/package-extension.mjs chrome",
    "extension:package:firefox": "node scripts/package-extension.mjs firefox",
    "deploy": "npm run wrangler -- deploy",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "wrangler": "4.157.0"
  }
}
