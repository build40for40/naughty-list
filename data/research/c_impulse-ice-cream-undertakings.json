ngs.pdf","hoc_paper_number":"","id":"9590685","isbn":"","number_of_pages":13,"title":"Birds Eye Wall’s (July 2000) undertakings (released in 2026)","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/5a7cf70fe5274a2af0ae28cd/Birds_Eye_Wall_s__July_2000__undertakings.pdf"},{"accessible":true,"alternative_format_contact_email":"general.enquiries@cma.gov.uk","assets":[{"asset_manager_id":"5a7f0473e5274a2e8ab49a45","filename":"Impulse_Ice_Cream__Mars_UK_Ltd_.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":49200,"filename":"Impulse_Ice_Cream__Mars_UK_Ltd_.pdf","hoc_paper_number":"","id":"9590686","isbn":"","number_of_pages":3,"title":"Impulse Ice Cream (Mars UK Ltd) (released in 2026)","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/5a7f0473e5274a2e8ab49a45/Impulse_Ice_Cream__Mars_UK_Ltd_.pdf"},{"accessible":false,"alternative_format_contact_email":"general.enquiries@cma.gov.uk","assets":[{"asset_manager_id":"5a7e1424ed915d74e6223f77","filename":"Impulse_Ice_Cream__Nestle_UK_Ltd_.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":63659,"filename":"Impulse_Ice_Cream__Nestle_UK_Ltd_.pdf","hoc_paper_number":"","id":"9590687","isbn":"","number_of_pages":3,"title":"Impulse Ice Cream (Nestle UK Ltd) (released in 2026)","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/5a7e1424ed915d74e6223f77/Impulse_Ice_Cream__Nestle_UK_Ltd_.pdf"}],"body":"<div class=\"govspeak\"><h3 id=\"undertakings-released\">Undertakings released</h3>\n\n<p>4 November 2026: The Competition and Markets Authority (CMA) published the <a href=\"https://www.gov.uk/government/consultations/provisional-decision-strategic-review-of-cma-markets-remedies\">final decision in its review of the undertakings</a>. The undertakings have now been released (are no longer in force) and have been removed from the <a href=\"https://www.gov.uk/government/collections/markets-orders-and-undertakings-register\">register of remedies in force</a>.</p>\n\n<h3 id=\"undertakings-description\">Undertakings description</h3>\n\n<p>These undertakings were given under the monopoly provisions of the Fair Trading Act 1973. They applied to wrapped Impulse ice cream products.They stopped Birds Eye Wall’s, Mars UK Limited and Nestle UK Limited from limiting the ability of the retailers they supply, to acquire and sell competing suppliers’ products. Birds Eye Wall’s additionally undertook not to prevent the retailers they supply from stocking competitors’ products in Birds Eye Wall’s-supplied freezers.</p>\n\n<p>A full set of documents that were published during this inquiry are available on <a rel=\"external\" href=\"https://webarchive.nationalarchives.gov.uk/ukgwa/20111202182413/http:/www.competition-commission.org.uk/rep_pub/reports/2000/436ice.htm#summary\">The National Archives</a> website.</p>\n</div>","change_history":[{"note":"Undertakings released.","public_timestamp":"2026-11-04T11:32:43Z"},{"note":"First published.","public_timestamp":"2000-01-28T00:00:00Z"}],"document_type_label":"Guidance","emphasised_organisations":["957eb4ec-089b-4f71-ba2a-dc69ac8919ea"],"featured_attachments":["9591262","9590684","9590685","9590686","9590687"],"first_public_at":"2000-01-28T00:00:00.000+00:00","political":false,"tags":{"browse_pages":[]}},"document_type":"guidance","first_published_at":"2000-01-28T00:00:00+00:00","links":{"available_translations":[{"api_path":"/api/content/government/publications/impulse-ice-cream-undertakings","api_url":"https://www.gov.uk/api/content/government/publications/impulse-ice-cream-undertakings","base_path":"/government/publications/impulse-ice-cream-undertakings","content_id":"5fe8f035-7631-11e4-a3cb-005056011aef",