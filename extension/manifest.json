{
  "manifest_version": 3,
  "name": "The Naughty List",
  "short_name": "Naughty List",
  "version": "0.0.2",
  "description": "See source-backed business information on shopping pages. Ethical verdicts appear only when a reviewed assessment is available.",
  "author": "40 for 40",
  "homepage_url": "https://github.com/build40for40/naughty-list",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://naughty-list-api.40for40.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "https://naughty-list-api.40for40.workers.dev/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/vt323-latin-400.woff2"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
