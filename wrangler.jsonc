{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naughty-list-api",
  "main": "worker/index.js",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/community",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "naughty-list",
    "database_id": "c464594e-3945-4ae7-b12a-4f522c7c77d3",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["17 5 * * *"] }
}
